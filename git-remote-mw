def git_bytes(args: list[str], quiet_stderr: bool = False) -> bytes:
    """Run git and return its raw stdout ("" if the command failed)."""
    proc = subprocess.run(
        ["git", *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL if quiet_stderr else None,
        check=False,
    )
    return proc.stdout


def git(args: list[str], quiet_stderr: bool = False) -> str:
    return git_bytes(args, quiet_stderr).decode("utf-8", "replace")


def git_config(key: str, boolean: bool = False) -> str:
    args = ["config", "--get"]
    if boolean:
        args.append("--bool")
    return git(args + [key], quiet_stderr=True).strip()


def git_config_bool(key: str, default: bool = False) -> bool:
    value = git_config(key, boolean=True)
    if not value:
        return default
    return value == "true"


def git_config_list(key: str) -> list[str]:
    """Values of a multi-valued config, split on whitespace.

    Accept both space-separated and multiple keys in the config file.
    """
    raw = git(["config", "--get-all", key], quiet_stderr=True)
    return [item for item in raw.split() if item]


def git_credential(cred: dict[str, str], operation: str = "fill") -> dict[str, str]:
    """Talk to git's credential API."""
    request = "".join(f"{k}={v}\n" for k, v in cred.items() if v) + "\n"
    proc = subprocess.run(
        ["git", "credential", operation],
        input=request.encode("utf-8"),
        stdout=subprocess.PIPE if operation == "fill" else subprocess.DEVNULL,
        check=False,
    )
    if operation != "fill":
        return cred
    filled = dict(cred)
    for line in proc.stdout.decode("utf-8", "replace").splitlines():
        key, _, value = line.partition("=")
        if key:
            filled[key] = value
    return filled


def empty_tree() -> str:
    """The empty tree object, created on demand for diffs of root commits."""
    sha1 = subprocess.run(
        ["git", "hash-object", "-w", "-t", "tree", "--stdin"],
        input=b"",
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    ).stdout.decode().strip()
    return sha1 or EMPTY_TREE_SHA1


# --------------------------------------------------------------------------
# file name mangling
# --------------------------------------------------------------------------


def clean_filename(filename: str) -> str:
    """Git file name -> MediaWiki page title."""
    filename = filename.replace(SLASH_REPLACEMENT, "/")
    # [, ], |, {, and } are forbidden by MediaWiki, even URL-encoded.  Do a
    # variant of URL-encoding, i.e. looks like URL-encoding, but with _ added
    # to prevent MediaWiki from thinking this is an actual special character.
    return re.sub(r"[\[\]{}|]", lambda m: "_%%_%x" % ord(m.group(0)), filename)


def smudge_filename(filename: str) -> str:
    """MediaWiki page title -> Git file name (without the .mw suffix)."""
    filename = filename.replace("/", SLASH_REPLACEMENT).replace(" ", "_")
    # Decode forbidden characters encoded in clean_filename().
    filename = re.sub(
        r"_%_([0-9a-fA-F]{2})", lambda m: chr(int(m.group(1), 16)), filename
    )
    limit = NAME_MAX - len(".mw")
    filename = filename[:limit]
    while len(filename.encode("utf-8")) > limit:
        filename = filename[:-1]
    return filename


def mediawiki_clean(text: str, page_created: bool) -> str:
    """Clean content before sending it to MediaWiki.

    MediaWiki does not allow blank space at the end of a page and ends with a
    single \\n, so right trim and add one \\n.
    """
    text = text.rstrip()
    if not text and page_created:
        # Creating empty pages is forbidden.
        text = EMPTY_CONTENT.rstrip()
    return text + "\n"


def mediawiki_smudge(text: str) -> str:
    """Filter applied on MediaWiki data before adding them to Git."""
    # MediaWiki right trims what it stores, so compare trimmed.
    if text.strip() == EMPTY_CONTENT.strip():
        text = ""
    # This \n is important.  This is due to mediawiki's way to handle end of
    # files.
    return text + "\n"


def fe_escape_path(path: str) -> str:
    """Quote a path for the fast-import stream."""
    path = path.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return f'"{path}"'


def sanitize_ident(name: str) -> str:
    """Make a string usable inside a fast-import identity."""
    return re.sub(r"[<>\n]", "_", name).strip() or "Anonymous"


# --------------------------------------------------------------------------
# MediaWiki Action API
# --------------------------------------------------------------------------


class MWError(Exception):
    def __init__(self, code: str, info: str):
        super().__init__(f"{code}: {info}")
        self.code = code
        self.info = info


def page_list(result: dict) -> list[dict]:
    """The pages of a query result, for either API formatversion."""
    pages = (result.get("query") or {}).get("pages")
    if not pages:
        return []
    if isinstance(pages, dict):  # formatversion=1
        return list(pages.values())
    return pages


def revision_content(rev: dict) -> str | None:
    """Wikitext of a revision, for either API formatversion, or None."""
    slots = rev.get("slots")
    if slots:
        main = slots.get("main") or {}
        content = main.get("content", main.get("*"))
    else:
        content = rev.get("content", rev.get("*"))
    return content if isinstance(content, str) else None


def message_text(message) -> str:
    """Readable text out of an API message, which may be a structured one."""
    if isinstance(message, dict):
        return str(message.get("text") or message.get("code") or message)
    return str(message) if message else ""


def continuation(result: dict) -> dict | None:
    """Parameters to add to the next query, or None when done."""
    if "continue" in result:  # modern API
        return dict(result["continue"])
    if "query-continue" in result:  # legacy API
        params: dict = {}
        for module in result["query-continue"].values():
            params.update(module)
        return params
    return None


class Transport:
    """HTTP with the two things urllib will not do: keep-alive and gzip.

    An import is hundreds of round trips to the same host, so paying for a
    fresh TCP (and TLS) handshake every time is worth avoiding, as is
    transferring wikitext uncompressed.
    """

    MAX_REDIRECTS = 5
    REDIRECTS = (301, 302, 303, 307, 308)

    def __init__(self, user_agent: str = USER_AGENT):
        self.user_agent = user_agent
        self.cookies = http.cookiejar.CookieJar()
        self.connections: dict[tuple, http.client.HTTPConnection] = {}
        self._ssl_context: ssl.SSLContext | None = None

    def ssl_context(self) -> ssl.SSLContext:
        """Verification set up the way git's own http.* config asks for."""
        if self._ssl_context is None:
            ca_info = git_config("http.sslCAInfo") or os.environ.get("GIT_SSL_CAINFO")
            context = ssl.create_default_context(cafile=ca_info or None)
            no_verify = os.environ.get("GIT_SSL_NO_VERIFY")
            if git_config("http.sslVerify", boolean=True) == "false" or (
                no_verify and no_verify not in ("0", "false")
            ):
                warn("warning: SSL certificate verification is disabled")
                context.check_hostname = False
                context.verify_mode = ssl.CERT_NONE
            self._ssl_context = context
        return self._ssl_context

    def _connection(self, parts) -> tuple[tuple, http.client.HTTPConnection, bool]:
        port = parts.port or (443 if parts.scheme == "https" else 80)
        key = (parts.scheme, parts.hostname, port)
        conn = self.connections.get(key)
        if conn is not None:
            return key, conn, True
        if parts.scheme == "https":
            conn = http.client.HTTPSConnection(
                parts.hostname, port, timeout=HTTP_TIMEOUT, context=self.ssl_context()
            )
        else:
            conn = http.client.HTTPConnection(
                parts.hostname, port, timeout=HTTP_TIMEOUT
            )
        self.connections[key] = conn
        return key, conn, False

    def _drop(self, key: tuple, conn: http.client.HTTPConnection) -> None:
        conn.close()
        if self.connections.get(key) is conn:
            del self.connections[key]

    def close(self) -> None:
        for key in list(self.connections):
            self._drop(key, self.connections[key])

    def request(
        self,
        url: str,
        data: bytes | None = None,
        content_type: str | None = None,
        redirects: int = 0,
    ) -> tuple[int, bytes]:
        """Perform one exchange, returning (status, body).

        Raises MWError("network", ...) if the exchange could not be made.  A
        request that may already have reached the server is never repeated
        behind the caller's back unless it is a GET.
        """
        parts = urllib.parse.urlsplit(url)
        method = "GET" if data is None else "POST"
        target = urllib.parse.urlunsplit(("", "", parts.path or "/", parts.query, ""))

        headers = {
            "User-Agent": self.user_agent,
            "Accept-Encoding": "gzip",
            "Connection": "keep-alive",
        }
        if data is not None:
            headers["Content-Type"] = (
                content_type or "application/x-www-form-urlencoded"
            )
            headers["Content-Length"] = str(len(data))
        # Let the cookie jar add (and later collect) session cookies.
        cookie_carrier = urllib.request.Request(url, data=data, headers=headers)
        self.cookies.add_cookie_header(cookie_carrier)
        headers = dict(cookie_carrier.header_items())

        for attempt in (0, 1):
            key, conn, reused = self._connection(parts)
            try:
                conn.request(method, target, body=data, headers=headers)
            except (http.client.HTTPException, OSError) as exc:
                # Typically a pooled connection the server closed meanwhile:
                # the request was not delivered, so it is safe to redo it.
                self._drop(key, conn)
                if reused and attempt == 0:
                    continue
                raise MWError("network", f"{method} {url}: {exc}") from exc
            try:
                resp = conn.getresponse()
                body = resp.read()
            except (http.client.HTTPException, OSError) as exc:
                self._drop(key, conn)
                # The server may have acted on a POST already; only a GET can
                # be replayed safely.
                if method == "GET" and reused and attempt == 0:
                    continue
                raise MWError("network", f"{method} {url}: {exc}") from exc
            break

        self.cookies.extract_cookies(resp, cookie_carrier)
        if resp.will_close:
            self._drop(key, conn)
        if resp.getheader("Content-Encoding", "").lower() == "gzip" and body:
            body = gzip.decompress(body)

        location = resp.getheader("Location")
        if resp.status in self.REDIRECTS and location:
            if redirects >= self.MAX_REDIRECTS:
                raise MWError("network", f"too many redirects for {url}")
            # 303 (and, as everybody does it, 302) turn a POST into a GET.
            follow_data = data if resp.status in (307, 308) else None
            return self.request(
                urllib.parse.urljoin(url, location),
                follow_data,
                content_type if follow_data is not None else None,
                redirects + 1,
            )
        return resp.status, body


class MediaWiki:
    """Just enough of the MediaWiki Action API."""

    # Status codes worth a second try; a POST is never retried, as the wiki
    # may have acted on it already.
    TRANSIENT = (429, 500, 502, 503, 504)

    def __init__(self, url: str, transport: Transport | None = None):
        url = url.rstrip("/")
        if url.endswith("/api.php"):
            self.api_url = url
            self.url = url[: -len("/api.php")]
        else:
            self.url = url
            self.api_url = url + "/api.php"
        self.transport = transport or Transport()
        self._csrf: str | None = None
        self._high_limits: bool | None = None

    # -- transport ---------------------------------------------------------

    def fetch(
        self, url: str, data: bytes | None = None, content_type: str | None = None
    ) -> tuple[int, bytes]:
        for attempt in range(3):
            status, body = self.transport.request(url, data, content_type)
            if status in self.TRANSIENT and data is None and attempt < 2:
                time.sleep(1 + attempt)
                continue
            return status, body
        return status, body

    def api(self, params: dict, post: bool = False) -> dict:
        """One API call.  Raises MWError on an API level error."""
        query = {}
        for key, value in params.items():
            if value is None or value is False:
                continue
            query[key] = "1" if value is True else str(value)
        query.setdefault("format", "json")
        query.setdefault("formatversion", "2")
        body = urllib.parse.urlencode(query, encoding="utf-8")

        if post or len(body) > 4000:
            status, raw = self.fetch(self.api_url, data=body.encode("utf-8"))
        else:
            status, raw = self.fetch(f"{self.api_url}?{body}")
        if not raw:
            raise MWError(f"http-{status}", "empty answer from the API")
        return self._answer(raw)

    @staticmethod
    def _answer(raw: bytes) -> dict:
        """Decode an API answer, turning an API error into an exception."""
        try:
            result = json.loads(raw.decode("utf-8"))
        except ValueError as exc:
            raise MWError("unparseable", f"{exc}: {raw[:200]!r}") from exc
        if not isinstance(result, dict):
            raise MWError("unparseable", f"unexpected API answer {result!r}")

        error = result.get("error")
        if error:
            raise MWError(
                str(error.get("code", "unknown")),
                str(error.get("info", error.get("*", error))),
            )
        return result

    def query_list(self, params: dict, key: str):
        """Iterate over all items of a list= query, following continuations."""
        params = dict(params, action="query")
        params.setdefault("continue", "")
        while True:
            result = self.api(params)
            for item in (result.get("query") or {}).get(key) or []:
                yield item
            cont = continuation(result)
            if not cont:
                return
            params.update(cont)

    def download(self, url: str) -> bytes | None:
        try:
            status, body = self.fetch(url)
        except MWError as exc:
            warn(f"Error downloading {url}: {exc.info}")
            return None
        if status != HTTP_CODE_OK:
            warn(f"Server response: {status}")
            return None
        return body

    # -- authentication ----------------------------------------------------

    def login(self, name: str, password: str, domain: str = "") -> None:
        """Log in, raising MWError if the wiki says no."""
        try:
            token = self.token("login")
        except MWError:
            token = None
        if token is None:
            # Really old wikis hand out the login token in a first, failing,
            # login attempt.
            first = self.api({"action": "login", "lgname": name}, post=True)
            token = (first.get("login") or {}).get("token")

        result = self.api(
            {
                "action": "login",
                "lgname": name,
                "lgpassword": password,
                "lgdomain": domain or None,
                "lgtoken": token,
            },
            post=True,
        )
        answer = result.get("login") or {}
        if answer.get("result") == "Success":
            return

        # action=login only accepts bot passwords on modern wikis; the
        # interactive login module accepts a normal one.
        reason = message_text(answer.get("reason")) or answer.get("result")
        try:
            result = self.api(
                {
                    "action": "clientlogin",
                    "username": name,
                    "password": password,
                    "domain": domain or None,
                    "logintoken": self.token("login"),
                    "loginreturnurl": self.url or "http://localhost/",
                    "rememberMe": "1",
                },
                post=True,
            )
        except MWError:
            raise MWError(answer.get("result", "Failed"), str(reason or "login failed"))
        client = result.get("clientlogin") or {}
        if client.get("status") == "PASS":
            return
        raise MWError(
            str(client.get("status") or answer.get("result") or "Failed"),
            message_text(client.get("message")) or reason or "login failed",
        )

    def token(self, kind: str = "csrf") -> str | None:
        result = self.api({"action": "query", "meta": "tokens", "type": kind})
        tokens = (result.get("query") or {}).get("tokens") or {}
        token = tokens.get(f"{kind}token")
        if token:
            return token
        # Legacy API (MediaWiki < 1.24).
        legacy = {"csrf": "edit"}.get(kind, kind)
        try:
            result = self.api({"action": "tokens", "type": legacy})
        except MWError:
            return None
        return (result.get("tokens") or {}).get(f"{legacy}token")

    def csrf_token(self) -> str:
        if self._csrf is None:
            token = self.token("csrf")
            if not token:
                raise MWError("notoken", "could not obtain an edit token")
            self._csrf = token
        return self._csrf

    def write(self, params: dict) -> dict:
        """POST a request that needs an edit token, refreshing a stale one."""
        for attempt in (0, 1):
            try:
                return self.api(dict(params, token=self.csrf_token()), post=True)
            except MWError as exc:
                if attempt == 0 and exc.code in (
                    "badtoken",
                    "notoken",
                    "assertuserfailed",
                ):
                    self._csrf = None
                    continue
                raise
        raise AssertionError("unreachable")

    def upload(self, filename: str, content: bytes, comment: str) -> dict:
        """action=upload, which needs multipart/form-data."""
        for attempt in (0, 1):
            fields = {
                "action": "upload",
                "format": "json",
                "formatversion": "2",
                "filename": filename,
                "comment": comment,
                "ignorewarnings": "1",
                "token": self.csrf_token(),
            }
            body, content_type = encode_multipart(
                fields, [("file", filename, content)]
            )
            _status, raw = self.fetch(self.api_url, data=body, content_type=content_type)
            try:
                return self._answer(raw)
            except MWError as exc:
                if attempt == 0 and exc.code in ("badtoken", "notoken"):
                    self._csrf = None
                    continue
                raise
        raise AssertionError("unreachable")


def encode_multipart(
    fields: dict[str, str], files: list[tuple[str, str, bytes]]
) -> tuple[bytes, str]:
    boundary = "git-remote-mw-" + os.urandom(16).hex()
    body = bytearray()
    for name, value in fields.items():
        body += f"--{boundary}\r\n".encode()
        body += f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode()
        body += value.encode("utf-8") + b"\r\n"
    for name, filename, content in files:
        body += f"--{boundary}\r\n".encode()
        body += (
            f'Content-Disposition: form-data; name="{name}"; filename="{filename}"\r\n'
        ).encode("utf-8")
        body += b"Content-Type: application/octet-stream\r\n\r\n"
        body += content + b"\r\n"
    body += f"--{boundary}--\r\n".encode()
    return bytes(body), f"multipart/form-data; boundary={boundary}"


