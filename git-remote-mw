VERSION = "0.1.0"
USER_AGENT = f"git-remote-mw/{VERSION} python-urllib/{sys.version_info[0]}"

# MediaWiki filenames can contain forward slashes.  This is what they are
# replaced with on the Git side.
SLASH_REPLACEMENT = "%2F"

# It's not always possible to delete pages (may require some privileges).
# Deleted pages are replaced with this content.
DELETED_CONTENT = "[[Category:Deleted]]\n"

# It's not possible to create empty pages.  New empty files in Git are sent
# with this content instead.
EMPTY_CONTENT = "<!-- empty page -->\n"

# Stand-in for a revision whose content the wiki refuses to hand out.
SUPPRESSED_REVISION = "<!-- suppressed revision -->\n"

# Used on Git's side to reflect empty edit messages on the wiki.
EMPTY_MESSAGE = "*Empty MediaWiki Message*"

# Used to reflect file creation or deletion in diff.
NULL_SHA1 = "0" * 40

# Number of page titles asked for at once in get_mw_page_list().
SLICE_SIZE = 50

# Number of pages whose linked mediafiles are queried at once.  The query is
# split in small batches because of the MW API limit on the number of links
# to be returned (500 links max).
BATCH_SIZE = 10

# Number of revision ids fetched with one API query: the API limit is 50, or
# 500 for an account with the apihighlimits right (bots and, usually, admins).
MAX_REVIDS = 50
MAX_REVIDS_HIGH = 500

# Longest file name component allowed by POSIX file systems.
NAME_MAX = 255

HTTP_TIMEOUT = 60
HTTP_CODE_OK = 200

# The one tree that is not in any repository but that git always knows about.
EMPTY_TREE_SHA1 = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"


# --------------------------------------------------------------------------
# output helpers
# --------------------------------------------------------------------------

# Everything Git reads from us (remote-helper answers *and* the fast-import
# stream, which may carry binary media files) goes to stdout as bytes.
OUT = sys.stdout.buffer

VERBOSITY = 1


def out(text: str) -> None:
    OUT.write(text.encode("utf-8"))


def out_flush() -> None:
    OUT.flush()


def warn(text: str) -> None:
    """Unconditional message to the user."""
    sys.stderr.write(text + "\n")
    sys.stderr.flush()


def log(text: str) -> None:
    """Progress message, silenced by `git <cmd> --quiet'."""
    if VERBOSITY >= 1:
        warn(text)


def debug(text: str) -> None:
    """Message only wanted with `git <cmd> --verbose'."""
    if VERBOSITY >= 2:
        warn(text)


def die(text: str) -> "NoReturn":  # noqa: F821
    warn(text)
    sys.exit(1)


def literal_data(content: str) -> None:
    data = content.encode("utf-8")
    out(f"data {len(data)}\n")
    OUT.write(data)


def literal_data_raw(content: bytes) -> None:
    """Output possibly binary content."""
    out(f"data {len(content)}\n")
    OUT.write(content)


# --------------------------------------------------------------------------
# git plumbing
